# ──────────────────────────────────────────────────────────
# 개인정보 동의서 수집 시스템 — 계정 설정 파일
# 이 파일을 복사해 .env 로 저장 후 실제 계정 정보를 입력하세요.
# .env 는 절대 git에 커밋하지 마세요.
# ──────────────────────────────────────────────────────────

# ── 현대닷컴 / myHyundai 통합 계정 ─────────────────────────
HMC_MAIN_EMAIL=your_email@example.com
HMC_MAIN_PASSWORD=your_password

# ── 현대샵 ─────────────────────────────────────────────────
HMC_SHOP_EMAIL=your_email@example.com
HMC_SHOP_PASSWORD=your_password

# ── E-pit (이피트) ──────────────────────────────────────────
HMC_EPIT_EMAIL=your_email@example.com
HMC_EPIT_PASSWORD=your_password

# ── 현대/제네시스 셀렉션 ────────────────────────────────────
HMC_SELECTION_EMAIL=your_email@example.com
HMC_SELECTION_PASSWORD=your_password

# ── 인재채용 포털 ───────────────────────────────────────────
HMC_TALENT_EMAIL=your_email@example.com
HMC_TALENT_PASSWORD=your_password

# ── Playwright 설정 ─────────────────────────────────────────
HEADLESS=true          # false 로 변경하면 브라우저 화면이 보임 (디버깅 시 유용)
SCRAPE_TIMEOUT=30000   # 페이지 로드 타임아웃 (ms)
